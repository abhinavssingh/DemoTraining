@using DemoTraining.Features.HomePage.Models
@model PageViewModel<HomePage>
@{}
<h1>@Html.PropertyFor(m => m.CurrentPage.Heading)</h1>   
<h2> @Html.PropertyFor(m => m.CurrentPage.Description)</h2>
@if (Model.CurrentPage.Links != null)
{
    foreach (var linkItem in Model.CurrentPage.Links)
    {
        <a data-epi-edit="Links" href="@linkItem.Href">@linkItem.Text</a>
    }
}
