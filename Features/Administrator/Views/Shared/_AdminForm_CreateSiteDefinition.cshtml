@{
    var bagLink = ViewBag.CurrentPageLink as EPiServer.Core.ContentReference;
    var currentLink = bagLink == null ? EPiServer.Core.ContentReference.StartPage : bagLink;
}
<form action="@(Url.ContentUrl(currentLink) + "createsitedefinition")" method="post">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label for="siteName">Site name</label>
        <input name="siteName" id="siteName" class="form-control" placeholder="Enter a site name" />
    </div>
    <div class="form-group">
        <label for="hostName">Host name</label>
        <input name="hostName" id="hostName" class="form-control" placeholder="Enter host name (e.g. example.local)" />
    </div>
    <input type="submit" value="Create site definition" class="btn btn-primary" />
</form>