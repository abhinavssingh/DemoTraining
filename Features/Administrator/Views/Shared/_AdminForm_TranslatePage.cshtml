@{
    var bagLink = ViewBag.CurrentPageLink as EPiServer.Core.ContentReference;
    var currentLink = bagLink == null ? EPiServer.Core.ContentReference.StartPage : bagLink;
}
<form action="@(Url.ContentUrl(currentLink) + "translatepage")" method="post">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label for="contentReference">Content reference</label>
        <input name="contentReference" id="contentReference" class="form-control" placeholder="Enter content reference (e.g. 5)" />
    </div>
    <div class="form-group">
        <label for="targetLanguage">Target language (culture code)</label>
        <input name="targetLanguage" id="targetLanguage" class="form-control" placeholder="e.g. sv-SE or en" />
    </div>
    <input type="submit" value="Translate page" class="btn btn-primary" />
</form>