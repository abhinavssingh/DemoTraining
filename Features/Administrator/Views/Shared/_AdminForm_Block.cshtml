@using EPiServer.Web.Mvc.Html
@{
    var currentLink = ViewBag.CurrentPageLink as EPiServer.Core.ContentReference ?? EPiServer.Core.ContentReference.StartPage;
}
<form action="@(Url.ContentUrl(currentLink) + "createblock")" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="currentPageLink" value="@ViewBag.CurrentPageLink" />
    <div class="form-group">
        <label for="heading">Heading</label>
        <input name="heading" id="heading" class="form-control" placeholder="Enter heading" />
    </div>
    <div class="form-group">
        <label for="text">Text</label>
        <textarea name="text" id="text" class="form-control" placeholder="Enter text"></textarea>
    </div>
    <div class="form-group">
        <label for="image">Image</label>
        <input name="image" id="image" class="form-control" placeholder="Enter image reference" />
    </div>
    <div class="form-group">
        <label for="link">Link</label>
        <input name="link" id="link" class="form-control" placeholder="Enter page link reference" />
    </div>
    <input type="submit" value="Save" class="btn btn-primary" />
</form>
