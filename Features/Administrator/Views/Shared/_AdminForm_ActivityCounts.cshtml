@{
    var bagLink = ViewBag.CurrentPageLink as EPiServer.Core.ContentReference;
    var currentLink = bagLink == null ? EPiServer.Core.ContentReference.StartPage : bagLink;
}
<form action="@(Url.ContentUrl(currentLink) + "activitycounts")" method="post">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label for="activityType">Activity</label>
        <select name="activityType" id="activityType" class="form-control">
            <option value="itemAdded">Item Added</option>
            <option value="publish">Publish</option>
            <option value="deleted">Deleted</option>
        </select>
    </div>
    <div class="form-group">
        <label for="startDate">Start date</label>
        <input name="startDate" id="startDate" type="date" class="form-control" />
    </div>
    <div class="form-group">
        <label for="endDate">End date</label>
        <input name="endDate" id="endDate" type="date" class="form-control" />
    </div>
    <input type="submit" value="Get counts" class="btn btn-primary" />
</form>