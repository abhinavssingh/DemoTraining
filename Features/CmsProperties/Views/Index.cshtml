@using DemoTraining.Features.CmsProperties.Models
@model PageViewModel<CmsPropertiesPage>

@{}
<table class="table">
    <thead>
        <tr>
            <th>@Html.PropertyFor(m => m.CurrentPage.CmsPropertyName)</th>
            <th>@Html.PropertyFor(m => m.CurrentPage.CmsPropertyValue)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (PropertyData prop in Model.CurrentPage.Property)
        {
            <tr>
                <td>@prop.Name</td>
                <td>@prop.Value</td>
            </tr>
        }
    </tbody>
</table>