@using EPiServer.Web.Mvc.Html
@model DemoTraining.Features.CmsProperties.Models.CmsPropertiesPage
@{}
<table class="table">
    <thead>
        <tr>
            <th>@Html.PropertyFor(m => m.CmsPropertyName)</th>
            <th>@Html.PropertyFor(m => m.CmsPropertyValue)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (PropertyData prop in Model.Property)
        {
            <tr>
                <td>@prop.Name</td>
                <td>@prop.Value</td>
            </tr>
        }
    </tbody>
</table>