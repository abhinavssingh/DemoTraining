<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- TODO CMS13: Suppress obsolete API warnings for backward compatibility during CMS 13 migration -->
    <!-- CS0618: SiteDefinition, PageReference, and other deprecated CMS 12 APIs are maintained for backward compatibility -->
    <NoWarn>CS0618;$(NoWarn)</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="EPiServer" />
    <Using Include="EPiServer.Core" />
    <Using Include="EPiServer.DataAbstraction" />
    <Using Include="EPiServer.DataAnnotations" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="EPiServer.CMS" Version="13.0.2" />
    <PackageReference Include="EPiServer.CMS.AspNetCore.TagHelpers" Version="13.0.2" />
    <!-- TODO CMS13: EPiServer.Find.Cms 16.7.x still requires CMS 12.x. Awaiting Find CMS 13 support. 
         Temporarily removed to unblock CMS 13 core migration. Reinstall after Find updates released. -->
    <!-- <PackageReference Include="EPiServer.Find.Cms" Version="16.7.1" /> -->
    <PackageReference Include="EPiServer.Forms" Version="6.0.0" />
    <PackageReference Include="EPiServer.Labs.GridView" Version="1.2.0" />
    <!-- STAGE 2 CMS13: TODO - Install Optimizely Graph SDK for search migration 
         Once available, add: <PackageReference Include="Optimizely.Graph.Sdk" Version="[latest]" /> -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.2" />
    <PackageReference Include="Wangkanai.Detection" Version="8.20.0" />
  </ItemGroup>
  
  <ItemGroup>
    <EmbeddedResource Include="Resources\Translations\**\*" />
  </ItemGroup>
  
  <ItemGroup>
    <Folder Include="Business\ScheduledJobs\" />
    <Folder Include="Features\Administrator\Models\" />
    <Folder Include="Features\Administrator\Controllers\" />
    <Folder Include="Features\Contact\Models\" />
    <Folder Include="Features\Landing\Models\" />
    <Folder Include="Features\StartPage\Models\" />
    <Folder Include="Components\" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include=".github\upgrades\cms-12-to-13-upgrade\BREAKING-CHANGES-CHECKLIST.md" />
    <None Include=".github\upgrades\cms-12-to-13-upgrade\CRITICAL-DECISION-CMS13-REQUIRES-NET10.md" />
    <None Include=".github\upgrades\cms-12-to-13-upgrade\PHASE-2-SEARCH-ASSESSMENT.md" />
    <None Include=".github\upgrades\cms-12-to-13-upgrade\phase-c-net10-upgrade-completion.md" />
  </ItemGroup>
</Project>
