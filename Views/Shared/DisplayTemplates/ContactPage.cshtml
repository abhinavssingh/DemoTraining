@using DemoTraining.Features.Contact.Models
@using EPiServer.Shell.Web.Mvc.Html
@model ContactPage

<p>
    @if(Model != null) 
    {
        @Model.PageName<br />
        @Html.Translate("/contact/phone")@: : @Model.Phone<br />
        @Html.Translate("/contact/email")@: : @Html.DisplayFor(m => m.Email)
    } 
    else
    {
        @Html.Translate("/contact/noneselected")  
    }
</p>
